   "source": [
    "from pathlib import Path\n",
    "\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "matplotlib.rcParams[\"axes.unicode_minus\"] = False\n",
    "plt.rcParams.update(\n",
    "    {\n",
    "        \"text.usetex\": True,\n",
    "        \"font.family\": \"serif\",\n",
    "        # \"font.serif\": \"Helvetica\",\n",
    "    }\n",
    ")\n",
    "plt.rc(\"text.latex\", preamble=r\"\\usepackage{amsfonts}\\usepackage{amsmath}\")\n",
    "\n",
    "savepath = Path(\n",
    "    \"/Users/shreyaspadhy/Documents/Obsidian Vault/phd-thesis/Chapter3/Figs/\"\n",
    ")\n",
    "# Create the figure\n",
    "mu_0 = 1.5\n",
    "sigma_0 = 1.0\n",
    "\n",
    "# dX_t = -mu_0 * X_t dt + sigma_0 dW_t\n",
    "mu = lambda x: -mu_0 * x  # mu(x) = -mu_0 * x\n",
    "sigma = lambda x: sigma_0  # sigma(x) = sigma_0\n",
    "\n",
    "T = 100\n",
    "t = np.linspace(0, 1, T)\n",
    "dt = 1 / T\n",
    "\n",
    "X_0 = 1.0\n",
    "\n",
    "fig = plt.figure(figsize=(8.27, 4.13), dpi=300)\n",
    "ax = fig.add_subplot(121)\n",
    "X_ode = np.zeros(T)\n",
    "X_ode[0] = X_0\n",
    "\n",
    "# Evolve the differential equation without noise\n",
    "for i in range(T - 1):\n",
    "    X_ode[i + 1] = X_ode[i] + mu(X_ode[i]) * dt\n",
    "\n",
    "ax.plot(t, X_ode, label=\"ODE\", color=\"black\", lw=3, ls=\"--\")\n",
    "\n",
    "# for mean m of p(X_t)\n",
    "# dm/dt = mu(X_t) . X_0\n",
    "mean_p = np.zeros(T)\n",
    "mean_p[0] = X_0\n",
    "\n",
    "# Evolve the ODE\n",
    "for i in range(T - 1):\n",
    "    mean_p[i + 1] = mean_p[i] + (-mu_0 * mean_p[i]) * dt\n",
    "\n",
    "# for covariance C of p(X_t)\n",
    "# dC/dt = 2 * mu(X_t) * C + sigma\n",
    "cov_p = np.zeros(T)\n",
    "cov_p[0] = 0\n",
    "\n",
    "# Evolve the ODE\n",
    "for i in range(T - 1):\n",
    "    cov_p[i + 1] = cov_p[i] + (-2 * mu_0 * cov_p[i] + sigma_0) * dt\n",
    "\n",
    "# ax.plot(t, mean_p, color=\"gray\", lw=2, label=\"SDE Mean\", ls=\"--\")\n",
    "\n",
    "ax.fill_between(\n",
    "    t,\n",
    "    mean_p - 2.96 * np.sqrt(cov_p),\n",
    "    mean_p + 2.96 * np.sqrt(cov_p),\n",
    "    color=\"gray\",\n",
    "    alpha=0.2,\n",
    ")\n",
    "ax.set_yticks([])\n",
    "ax.set_xticks([])\n",
    "# ax.set_xticklabels([0.0, 1.0], fontsize=16)\n",
    "ax.set_xticks([0.0, 1.0], [0.0, 1.0], fontsize=16)\n",
    "ax.set_xlabel(r\"$t \\rightarrow$\", fontsize=16)\n",
    "ax.set_ylim([-4.0, 8])\n",
    "\n",
    "# ax.axvline(x=0.7, color='white', linestyle=':', alpha=0.8)\n",
    "# ax.text(0.71, 4.3, r'$X_t$', fontsize=16, color='white')\n",
    "\n",
    "# ax.set_aspect('equal')\n",
    "# ax.set_xticks([])\n",
    "ax.spines[\"top\"].set_visible(False)\n",
    "ax.spines[\"right\"].set_visible(False)\n",
    "ax.spines[\"bottom\"].set_visible(False)\n",
    "ax.spines[\"left\"].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "ax_3d = fig.add_subplot(122, projection=\"3d\")\n",
    "# ax_3d.view_init(elev=20, azim=-45)  # Rotate view to put X=0 on left\n",
    "# Plot ODE trajectory along x-y plane (bottom plane)\n",
    "ax_3d.plot(\n",
    "    t,\n",
    "    X_ode,\n",
    "    zs=0,\n",
    "    zdir=\"z\",\n",
    "    color=\"black\",\n",
    "    lw=3,\n",
    "    label=r\"$\\frac{d X_t}{d t} = - \\mu_0 X_t$\",\n",
    "    ls=\"--\",\n",
    ")\n",
    "\n",
    "# ax_3d.plot(\n",
    "#     t,\n",
    "#     mean_p,\n",
    "#     zs=0,\n",
    "#     zdir=\"z\",\n",
    "#     color=\"black\",\n",
    "#     lw=2,\n",
    "#     label=\"\",\n",
    "#     ls=\"--\",\n",
    "#     alpha=0.0,\n",
    "# )\n",
    "\n",
    "ax_3d.add_collection3d(\n",
    "    plt.fill_between(\n",
    "        t,\n",
    "        mean_p - 2.96 * np.sqrt(cov_p),\n",
    "        mean_p + 2.96 * np.sqrt(cov_p),\n",
    "        color=\"gray\",\n",
    "        alpha=0.1,\n",
    "    ),\n",
    "    zs=0,\n",
    "    zdir=\"z\",\n",
    ")\n",
    "\n",
    "\n",
    "def animate(idx, line, text, text_3d, gaussian_line, surf, sde_plots, sde3d_plots):\n",
    "    mean, cov = mean_p[idx], cov_p[idx]\n",
    "\n",
    "    x_p = t[idx]\n",
    "    y_p = np.linspace(X_ode[idx] - 3, X_ode[idx] + 3, 100)\n",
    "\n",
    "    # Calculate Gaussian at current time\n",
    "    z = 1 / (cov * np.sqrt(2 * np.pi)) * np.exp(-((y_p - mean) ** 2) / (2 * cov))\n",
    "\n",
    "    # Normalize the distribution\n",
    "    z = z / np.sum(z)\n",
    "\n",
    "    # Create the vertical plane\n",
    "    Y_p, Z_p = np.meshgrid(y_p, np.linspace(0, 1.2 * np.max(z), 100))\n",
    "    X_p = np.full_like(Y_p, x_p)\n",
    "\n",
    "    sdes = []\n",
    "    for i in range(15):\n",
    "        noises = np.random.normal(0, 1, T)\n",
    "        X_sde = np.zeros(T)\n",
    "        X_sde[0] = X_0\n",
    "        # Evolve the differential equation with noise (using Euler-Maruyama which we'll discuss later)\n",
    "        for i in range(T - 1):\n",
    "            X_sde[i + 1] = (\n",
    "                X_sde[i] + mu(X_sde[i]) * dt + sigma(X_sde[i]) * np.sqrt(dt) * noises[i]\n",
    "            )\n",
    "\n",
    "        sdes.append(X_sde)\n",
    "\n",
    "    if (\n",
    "        gaussian_line is None\n",
    "        and surf is None\n",
    "        and line is None\n",
    "        and text is None\n",
    "        and text_3d is None\n",
    "        and sde_plots is None\n",
    "        and sde3d_plots is None\n",
    "    ):\n",
    "        # Plot the Gaussian curve\n",
    "        gaussian_line = ax_3d.plot(\n",
    "            [x_p] * len(y_p), y_p, z, color=\"grey\", lw=2, zorder=10\n",
    "        )\n",
    "        text_3d = ax_3d.text(\n",
    "            x_p - 0.15,\n",
    "            y_p[0],\n",
    "            0.8 * np.max(z),\n",
    "            r\"$\\mathbb{P}(X_t)$\",\n",
    "            fontsize=16,\n",
    "            color=\"black\",\n",
    "        )\n",
    "\n",
    "        surf = None\n",
    "        line = ax.plot([x_p] * len(y_p), y_p, color=\"black\", alpha=0.8, linestyle=\"--\")\n",
    "        text = ax.text(x_p + 0.05, y_p[0], r\"$X_t$\", fontsize=16, color=\"black\")\n",
    "\n",
    "        sde_plots = []\n",
    "        sde3d_plots = []\n",
    "        for i, sde in enumerate(sdes):\n",
    "            sde_plot = ax.plot(t, sde, color=\"grey\", ls=\"--\", alpha=0.5)\n",
    "            # Only add a label to the first SDE trajectory for the legend\n",
    "            if i == 0:\n",
    "                sde3d_plot = ax_3d.plot(\n",
    "                    t,\n",
    "                    sde,\n",
    "                    zs=0,\n",
    "                    zdir=\"z\",\n",
    "                    color=\"grey\",\n",
    "                    ls=\"--\",\n",
    "                    alpha=0.5,\n",
    "                    label=r\"$\\frac{d X_t}{d t} = - \\mu_0 X_t + \\sigma_0 \\times \\text{noise}$\",\n",
    "                )\n",
    "            else:\n",
    "                sde3d_plot = ax_3d.plot(\n",
    "                    t, sde, zs=0, zdir=\"z\", color=\"grey\", ls=\"--\", alpha=0.5\n",
    "                )\n",
    "            sde_plots.append(sde_plot)\n",
    "            sde3d_plots.append(sde3d_plot)\n",
    "    else:\n",
    "        gaussian_line[0].set_data_3d([x_p] * len(y_p), y_p, z)\n",
    "        line[0].set_data([x_p] * len(y_p), y_p)\n",
    "        text.set_position((x_p + 0.05, y_p[0]))\n",
    "        text_3d.set_position((x_p - 0.25, y_p[0], 0.8 * np.max(z)))\n",
    "        for i, sde in enumerate(sdes):\n",
    "            sde_plots[i][0].set_data(t, sde)\n",
    "            sde3d_plots[i][0].set_data_3d(t, sde, np.zeros(T))\n",
    "\n",
    "    return line, text, text_3d, gaussian_line, surf, sde_plots, sde3d_plots\n",
    "\n",
    "\n",
    "line, text, text_3d, gaussian_line, surf, sde_plots, sde3d_plots = animate(\n",
    "    50, None, None, None, None, None, None, None\n",
    ")\n",
    "\n",
    "# Customize the plot\n",
    "ax_3d.set_xlabel(\"Time\")\n",
    "ax_3d.view_init(elev=20.0, azim=-60, roll=0)\n",
    "\n",
    "# ax_3d.set_zlim(0, np.max(z))\n",
    "ax_3d.set_xticks([0.0, 1.0], [0.0, 1.0], minor=False)\n",
    "ax_3d.set_yticks([])\n",
    "ax_3d.set_zticks([])\n",
    "ax_3d.set_ylabel(r\"$X_t$\", fontsize=16)\n",
    "ax_3d.set_xlabel(r\"$t \\rightarrow$\", fontsize=16)\n",
    "ax_3d.set_zlabel(r\"$\\mathbb{P}(X_t)$\", fontsize=16)\n",
    "\n",
    "# Remove grid and set background color\n",
    "ax_3d.grid(False)\n",
    "ax_3d.xaxis.pane.fill = False\n",
    "ax_3d.yaxis.pane.fill = False\n",
    "ax_3d.zaxis.pane.fill = False\n",
    "\n",
    "# Remove all grid lines and pane edges\n",
    "ax_3d.xaxis.pane.set_edgecolor(\"none\")\n",
    "ax_3d.yaxis.pane.set_edgecolor(\"none\")\n",
    "ax_3d.zaxis.pane.set_edgecolor(\"none\")\n",
    "ax_3d.xaxis._axinfo[\"grid\"][\"color\"] = (1, 1, 1, 0)\n",
    "ax_3d.yaxis._axinfo[\"grid\"][\"color\"] = (1, 1, 1, 0)\n",
    "ax_3d.zaxis._axinfo[\"grid\"][\"color\"] = (1, 1, 1, 0)\n",
    "\n",
    "ax_3d.zaxis.set_visible(False)\n",
    "\n",
    "plt.legend(fontsize=12, loc=\"upper right\", frameon=False)\n",
    "plt.savefig(\n",
    "    Path(savepath) / \"Vector\" / \"sde_prob.pdf\",\n",
    "    format=\"pdf\",\n",
    "    transparent=True,\n",
    "    bbox_inches=\"tight\",\n",
    "    dpi=400,\n",
    ")\n",
    "plt.savefig(\n",
    "    Path(savepath) / \"Raster\" / \"sde_prob.png\",\n",
    "    format=\"png\",\n",
    "    transparent=True,\n",
    "    bbox_inches=\"tight\",\n",
    "    dpi=400,\n",
    ")\n",
    "plt.show()"
   ]
  },
