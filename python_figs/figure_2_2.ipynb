    "#!/usr/bin/env python\n",
    "\"\"\"\n",
    "Uniform-sized multi-panel figures\n",
    "--------------------------------\n",
    "This script produces **two figures** that will sit side-by-side on a\n",
    "single row in your thesis/page layout while keeping every plotting box\n",
    "(i.e. each individual axis) the *exact* same size.\n",
    "\n",
    "* **Figure A** – importance-sampling proposals *(2 panels → spans 2 grid\n",
    "  columns)*\n",
    "* **Figure B** – annealing path *(4 panels → spans 4 grid\n",
    "  columns—edit `BETAS_PLOT` if you later decide to show 6 panels; sizing\n",
    "  adapts automatically)*\n",
    "\n",
    "Key idea\n",
    "~~~~~~~~\n",
    "We introduce a single constant, ``BOX = 1.6 # inches``. Every axis is a\n",
    "**square of 1.6 in × 1.6 in**.  A figure that contains *n* horizontal\n",
    "panels therefore gets width = ``n * BOX`` and height = ``BOX``.  Except\n",
    "for a hair-line gap (``wspace≈0.04\"``), all visible boxes are identical.\n",
    "\n",
    "All stylistic settings (colour, LaTeX fonts, legend, etc.) are carried\n",
    "forward from your latest snippet.\n",
    "\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "from matplotlib.lines import Line2D\n",
    "from scipy.stats import multivariate_normal\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "#  Matplotlib / LaTeX setup  (unchanged)\n",
    "# ------------------------------------------------------------------\n",
    "matplotlib.rcParams[\"axes.unicode_minus\"] = False\n",
    "plt.rcParams.update({\"text.usetex\": True, \"font.family\": \"serif\"})\n",
    "plt.rc(\"text.latex\", preamble=r\"\\usepackage{amsfonts}\\usepackage{amsmath}\")\n",
    "\n",
    "savepath = Path(\n",
    "    \"/Users/shreyaspadhy/Documents/Obsidian Vault/phd-thesis/Chapter2/Figs/\"\n",
    ")\n",
    "\n",
    "# ---- size of *one* square panel --------------------------------------------\n",
    "BOX = 1.6  # inches — change once, propagates everywhere\n",
    "GAP = 0.08  # white-space fraction between panels\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Utilities\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "\n",
    "def clean_axis(ax):\n",
    "    \"\"\"Remove all spines and set outward ticks.\"\"\"\n",
    "    for side in (\"top\", \"right\", \"bottom\", \"left\"):\n",
    "        ax.spines[side].set_visible(False)\n",
    "    ax.tick_params(direction=\"out\", length=4, width=0.8)\n",
    "\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Distributions\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "\n",
    "def f_T(x: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Target density: a 3-component Gaussian mixture.\"\"\"\n",
    "    means = [np.array([0.0, 0.0]), np.array([1.5, 1.5]), np.array([-2.5, -2.5])]\n",
    "    covs = [\n",
    "        np.array([[0.1, 0.05], [0.05, 0.1]]),\n",
    "        np.array([[0.05, -0.03], [-0.03, 0.05]]),\n",
    "        np.array([[0.05, 0.0], [0.0, 0.05]]),\n",
    "    ]\n",
    "    weights = [0.6, 0.3, 0.1]\n",
    "    pdf = np.zeros(x.shape[0])\n",
    "    for w, m, c in zip(weights, means, covs):\n",
    "        pdf += w * multivariate_normal(m, c).pdf(x)\n",
    "    return pdf\n",
    "\n",
    "\n",
    "def f_0(x: np.ndarray) -> np.ndarray:\n",
    "    return multivariate_normal(np.zeros(2), np.eye(2)).pdf(x)\n",
    "\n",
    "\n",
    "def f_t(x: np.ndarray, beta: float) -> np.ndarray:\n",
    "    return np.power(f_0(x), 1.0 - beta) * np.power(f_T(x), beta)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "#  Common grid for all contours\n",
    "# ----------------------------------------------------------------------------\n",
    "\n",
    "gridx, gridy = np.mgrid[-3:3:0.01, -3:3:0.01]\n",
    "grid = np.dstack((gridx, gridy))\n",
    "\n",
    "pdf_T = f_T(grid.reshape(-1, 2)).reshape(grid.shape[:2])\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "#  Figure A – importance-sampling proposals (2 panels)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "N = 100\n",
    "q_1 = multivariate_normal(np.array([-2.0, -2.0]), 0.1 * np.eye(2))\n",
    "q_2 = multivariate_normal(np.array([0.0, 0.0]), np.eye(2))\n",
    "\n",
    "samples_1 = q_1.rvs(N)\n",
    "samples_2 = q_2.rvs(N)\n",
    "\n",
    "q_pdf_1 = q_1.pdf(grid.reshape(-1, 2)).reshape(grid.shape[:2])\n",
    "q_pdf_2 = q_2.pdf(grid.reshape(-1, 2)).reshape(grid.shape[:2])\n",
    "\n",
    "figA_w = 2 * BOX  # two panels\n",
    "figA_h = 2.5 * BOX\n",
    "figA, axA = plt.subplots(\n",
    "    1, 2, figsize=(figA_w, figA_h), dpi=400, sharex=True, sharey=True\n",
    ")\n",
    "figA.subplots_adjust(wspace=GAP)\n",
    "\n",
    "sns_blue = sns.color_palette(\"tab10\")[0]\n",
    "\n",
    "for ax, qsamp, qpdf, title in zip(\n",
    "    axA,\n",
    "    (samples_1, samples_2),\n",
    "    (q_pdf_1, q_pdf_2),\n",
    "    (\"Worse proposal\", \"Better proposal\"),\n",
    "):\n",
    "    ax.contour(gridx, gridy, pdf_T, levels=20, cmap=\"grey\", linewidths=0.5, zorder=0)\n",
    "    ax.scatter(\n",
    "        qsamp[:, 0], qsamp[:, 1], s=3, alpha=0.3, marker=\"o\", color=sns_blue, zorder=5\n",
    "    )\n",
    "    ax.contour(\n",
    "        gridx, gridy, qpdf, levels=20, cmap=\"grey\", alpha=0.4, linewidths=0.4, zorder=1\n",
    "    )\n",
    "    ax.set_title(title, fontsize=9)\n",
    "    ax.set(xlim=(-3, 3), ylim=(-3, 3), xlabel=r\"$x_1$\")\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "    ax.set_xticklabels([])\n",
    "    ax.set_yticklabels([])\n",
    "    ax.grid(True, which=\"major\", linewidth=0.4, alpha=0.3)\n",
    "    ax.set_aspect(\"equal\")\n",
    "    clean_axis(ax)\n",
    "\n",
    "axA[0].set(ylabel=r\"$x_2$\")\n",
    "\n",
    "# Custom legend (in first panel)\n",
    "legend_elements = [\n",
    "    Line2D([0], [0], color=\"grey\", lw=0.5, label=r\"Target $\\pi$\"),\n",
    "    Line2D([0], [0], color=\"grey\", alpha=0.4, lw=0.4, label=r\"Proposal $q$\"),\n",
    "    Line2D(\n",
    "        [0],\n",
    "        [0],\n",
    "        marker=\"o\",\n",
    "        color=sns_blue,\n",
    "        markersize=4,\n",
    "        linestyle=\"None\",\n",
    "        alpha=0.3,\n",
    "        label=\"Samples\",\n",
    "    ),\n",
    "]\n",
    "axA[0].legend(handles=legend_elements, fontsize=6, loc=\"upper left\", frameon=False)\n",
    "\n",
    "figA.tight_layout()\n",
    "(figA_out := savepath / \"Vector\" / \"is_worse_vs_better.pdf\").parent.mkdir(\n",
    "    parents=True, exist_ok=True\n",
    ")\n",
    "figA.savefig(figA_out, transparent=True, bbox_inches=\"tight\")\n",
    "figA.savefig(\n",
    "    savepath / \"Raster\" / \"is_worse_vs_better.png\",\n",
    "    dpi=400,\n",
    "    transparent=True,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "# plt.close(figA)\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "#  Figure B – annealing path (default 4 panels)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "BETAS_PLOT = [0.0, 0.25, 0.75, 1.0]  # <-- extend this list to 6 values if desired\n",
    "n_panels_B = len(BETAS_PLOT)\n",
    "figB_w = n_panels_B * BOX\n",
    "figB_h = 2.5 * BOX\n",
    "\n",
    "figB, axB = plt.subplots(\n",
    "    1, n_panels_B, figsize=(figB_w, figB_h), dpi=400, sharex=True, sharey=True\n",
    ")\n",
    "figB.subplots_adjust(wspace=GAP)\n",
    "\n",
    "for ax, beta in zip(axB, BETAS_PLOT):\n",
    "    pdf_beta = f_t(grid.reshape(-1, 2), beta).reshape(grid.shape[:2])\n",
    "    ax.contour(gridx, gridy, pdf_beta, levels=15, cmap=\"grey\", linewidths=0.5)\n",
    "    ax.set_title(rf\"$\\beta={beta:.2f}$\", fontsize=9)\n",
    "    ax.set(xlim=(-3, 3), ylim=(-3, 3))\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "    ax.set_aspect(\"equal\")\n",
    "    ax.grid(True, which=\"major\", linewidth=0.4, alpha=0.3)\n",
    "    clean_axis(ax)\n",
    "\n",
    "figB.tight_layout()\n",
    "(figB_out := savepath / \"Vector\" / \"annealed_distributions.pdf\").parent.mkdir(\n",
    "    parents=True, exist_ok=True\n",
    ")\n",
    "figB.savefig(figB_out, transparent=True, bbox_inches=\"tight\")\n",
    "figB.savefig(\n",
    "    savepath / \"Raster\" / \"annealed_distributions.png\",\n",
    "    dpi=400,\n",
    "    transparent=True,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "# plt.close(figB)\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "#  Confirmation\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "print(\"Figures saved to:\")\n",
    "for p in (figA_out, figB_out):\n",
    "    print(\"  •\", p)"
   ]
  },
