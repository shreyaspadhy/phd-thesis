   ],
   "source": [
    "#!/usr/bin/env python\n",
    "\"\"\"\n",
    "Ultra‑compact multi‑panel figures\n",
    "--------------------------------\n",
    "This revision *squeezes every last pixel* out of the available space:\n",
    "\n",
    "* **No external margins** – axes hug the canvas; `subplots_adjust` sets\n",
    "  all margins to *zero* so the only gaps you see are the intentional\n",
    "  panel separations.\n",
    "* **Gap set in inches** – a single constant `PANEL_GAP = 0.02 # inches`\n",
    "  defines the whitespace between adjacent columns.  Change once to scale\n",
    "  everywhere.\n",
    "* **Figure width calculation** – width = `n_panels * BOX + (n_panels – 1)\n",
    "  * PANEL_GAP`, so each square axis keeps its full `BOX×BOX` area.\n",
    "* **Figure height** – a hair taller than `BOX` (`BOX + 0.05″`) to leave\n",
    "  head‑room for titles / legend without adding vertical void.\n",
    "\n",
    "Everything else (fonts, colours, legend, LaTeX) is as before.\n",
    "\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "from matplotlib.lines import Line2D\n",
    "from scipy.stats import multivariate_normal\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "#  Matplotlib / LaTeX setup  (unchanged)\n",
    "# ------------------------------------------------------------------\n",
    "matplotlib.rcParams[\"axes.unicode_minus\"] = False\n",
    "plt.rcParams.update({\"text.usetex\": True, \"font.family\": \"serif\"})\n",
    "plt.rc(\"text.latex\", preamble=r\"\\usepackage{amsfonts}\\usepackage{amsmath}\")\n",
    "\n",
    "savepath = Path(\n",
    "    \"/Users/shreyaspadhy/Documents/Obsidian Vault/phd-thesis/Chapter2/Figs/\"\n",
    ")\n",
    "\n",
    "# ---- master geometry --------------------------------------------------------\n",
    "BOX = 2.15  # in – size of ONE square axis\n",
    "PANEL_GAP = 0.02  # in – horizontal gap between neighbouring axes\n",
    "\n",
    "# convenience: convert gap (in) → fraction of axis‑width required by subplots_adjust\n",
    "WS_FRACTION = PANEL_GAP / BOX\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Utilities\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "\n",
    "def clean_axis(ax):\n",
    "    \"\"\"Strip all spines and ticks for a minimalist look.\"\"\"\n",
    "    for side in (\"top\", \"right\", \"bottom\", \"left\"):\n",
    "        ax.spines[side].set_visible(False)\n",
    "    ax.tick_params(direction=\"out\", length=3, width=0.7)\n",
    "\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Distributions\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "\n",
    "def f_T(x: np.ndarray) -> np.ndarray:\n",
    "    means = [np.array([0.0, 0.0]), np.array([1.5, 1.5]), np.array([-2.5, -2.5])]\n",
    "    covs = [\n",
    "        np.array([[0.1, 0.05], [0.05, 0.1]]),\n",
    "        np.array([[0.05, -0.03], [-0.03, 0.05]]),\n",
    "        np.array([[0.05, 0.0], [0.0, 0.05]]),\n",
    "    ]\n",
    "    weights = [0.6, 0.3, 0.1]\n",
    "    pdf = np.zeros(x.shape[0])\n",
    "    for w, m, c in zip(weights, means, covs):\n",
    "        pdf += w * multivariate_normal(m, c).pdf(x)\n",
    "    return pdf\n",
    "\n",
    "\n",
    "def f_0(x: np.ndarray) -> np.ndarray:\n",
    "    return multivariate_normal(np.zeros(2), np.eye(2)).pdf(x)\n",
    "\n",
    "\n",
    "def f_t(x: np.ndarray, beta: float) -> np.ndarray:\n",
    "    return np.power(f_0(x), 1.0 - beta) * np.power(f_T(x), beta)\n",
    "\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Common grid for contour plots\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "gridx, gridy = np.mgrid[-3:3:0.01, -3:3:0.01]\n",
    "GRID = np.dstack((gridx, gridy))\n",
    "PDF_T = f_T(GRID.reshape(-1, 2)).reshape(GRID.shape[:2])\n",
    "\n",
    "# colour\n",
    "sns_blue = sns.color_palette(\"tab10\")[0]\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "#  Figure A – importance‑sampling proposals (2 panels)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "N = 100\n",
    "q_1 = multivariate_normal(np.array([-2.0, -2.0]), 0.1 * np.eye(2))\n",
    "q_2 = multivariate_normal(np.array([0.0, 0.0]), np.eye(2))\n",
    "\n",
    "samples = [q_1.rvs(N), q_2.rvs(N)]\n",
    "q_pdfs = [\n",
    "    q_1.pdf(GRID.reshape(-1, 2)).reshape(GRID.shape[:2]),\n",
    "    q_2.pdf(GRID.reshape(-1, 2)).reshape(GRID.shape[:2]),\n",
    "]\n",
    "\n",
    "figA_w = 2 * BOX + PANEL_GAP  # two panels → one gap\n",
    "figA_h = BOX + 0.05  # tiny head‑room for title / legend\n",
    "\n",
    "print(f\"dimensions of figA: {figA_w}, {figA_h}\")\n",
    "figA, axA = plt.subplots(\n",
    "    1, 2, figsize=(figA_w, figA_h), dpi=300, sharex=True, sharey=True\n",
    ")\n",
    "figA.subplots_adjust(left=0, right=1, top=1, bottom=0, wspace=WS_FRACTION, hspace=0)\n",
    "\n",
    "for ax, samp, qpdf, ttl in zip(\n",
    "    axA, samples, q_pdfs, (\"Worse proposal\", \"Better proposal\")\n",
    "):\n",
    "    ax.contour(gridx, gridy, PDF_T, levels=20, cmap=\"grey\", linewidths=0.45, zorder=0)\n",
    "    ax.scatter(samp[:, 0], samp[:, 1], s=3, alpha=0.3, color=sns_blue, zorder=5)\n",
    "    ax.contour(\n",
    "        gridx, gridy, qpdf, levels=20, cmap=\"grey\", alpha=0.4, linewidths=0.35, zorder=2\n",
    "    )\n",
    "    ax.set_title(ttl, fontsize=14, pad=2)\n",
    "    ax.set(xlim=(-3, 3), ylim=(-3, 3))\n",
    "    ax.set_xticks([]), ax.set_yticks([])\n",
    "    ax.set_aspect(\"equal\")\n",
    "    ax.grid(True, lw=0.35, alpha=0.25)\n",
    "    clean_axis(ax)\n",
    "\n",
    "# legend inside first panel (offset slightly)\n",
    "legend_handles = [\n",
    "    Line2D([0], [0], color=\"grey\", lw=0.45, label=r\"Target $\\pi$\"),\n",
    "    Line2D([0], [0], color=\"grey\", alpha=0.4, lw=0.35, label=r\"Proposal $q$\"),\n",
    "    Line2D(\n",
    "        [0],\n",
    "        [0],\n",
    "        marker=\"o\",\n",
    "        color=sns_blue,\n",
    "        markersize=4,\n",
    "        linestyle=\"None\",\n",
    "        alpha=0.3,\n",
    "        label=\"Samples\",\n",
    "    ),\n",
    "]\n",
    "axA[0].legend(\n",
    "    handles=legend_handles, fontsize=12, frameon=False, loc=\"upper left\", borderpad=0.2\n",
    ")\n",
    "\n",
    "(figA_out := savepath / \"Vector\" / \"is_worse_vs_better.pdf\").parent.mkdir(\n",
    "    parents=True, exist_ok=True\n",
    ")\n",
    "figA.savefig(figA_out, transparent=True, bbox_inches=\"tight\")\n",
    "figA.savefig(\n",
    "    savepath / \"Raster\" / \"is_worse_vs_better.png\",\n",
    "    dpi=400,\n",
    "    transparent=True,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "# plt.close(figA)\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "#  Figure B – annealing path (4 panels, extend list for more)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "BETAS_PLOT = [0.0, 0.25, 0.75, 1.0]\n",
    "N_B = len(BETAS_PLOT)\n",
    "figB_w = N_B * BOX + (N_B - 1) * PANEL_GAP\n",
    "figB_h = BOX + 0.05\n",
    "print(f\"dimensions of figB: {figB_w}, {figB_h}\")\n",
    "figB, axB = plt.subplots(\n",
    "    1, N_B, figsize=(figB_w, figB_h), dpi=300, sharex=True, sharey=True\n",
    ")\n",
    "figB.subplots_adjust(left=0, right=1, top=1, bottom=0, wspace=WS_FRACTION, hspace=0)\n",
    "\n",
    "for ax, beta in zip(axB, BETAS_PLOT):\n",
    "    pdf_b = f_t(GRID.reshape(-1, 2), beta).reshape(GRID.shape[:2])\n",
    "    ax.contour(gridx, gridy, pdf_b, levels=15, cmap=\"grey\", linewidths=0.45)\n",
    "    ax.set_title(rf\"$\\beta={beta:.2f}$\", fontsize=14, pad=2)\n",
    "    ax.set(xlim=(-3, 3), ylim=(-3, 3))\n",
    "    ax.set_xticks([]), ax.set_yticks([])\n",
    "    ax.set_aspect(\"equal\")\n",
    "    ax.grid(True, lw=0.35, alpha=0.25)\n",
    "    clean_axis(ax)\n",
    "\n",
    "(figB_out := savepath / \"Vector\" / \"annealed_distributions.pdf\").parent.mkdir(\n",
    "    parents=True, exist_ok=True\n",
    ")\n",
    "figB.savefig(figB_out, transparent=True, bbox_inches=\"tight\")\n",
    "figB.savefig(\n",
    "    savepath / \"Raster\" / \"annealed_distributions.png\",\n",
    "    dpi=400,\n",
    "    transparent=True,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "# plt.close(figB)\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "#  Confirmation\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "print(\"Figures saved to:\")\n",
    "for p in (figA_out, figB_out):\n",
    "    print(\"  •\", p)"
   ]
  },
