                "# ---------------------------------------------------------------\n",
                "#  Annealed ULA demo – density strips all facing right\n",
                "# ---------------------------------------------------------------\n",
                "import matplotlib\n",
                "import matplotlib.pyplot as plt\n",
                "import numpy as np\n",
                "import seaborn as sns\n",
                "from scipy.stats import norm\n",
                "\n",
                "# ------ matplotlib / LaTeX cosmetics (optional) -----------------\n",
                "matplotlib.rcParams[\"axes.unicode_minus\"] = False\n",
                "plt.rcParams.update({\"text.usetex\": True, \"font.family\": \"serif\"})\n",
                "plt.rc(\"text.latex\", preamble=r\"\\usepackage{amsfonts}\\usepackage{amsmath}\")\n",
                "\n",
                "sns_blue = sns.color_palette(\"tab10\")[0]\n",
                "sns_brown = sns.color_palette(\"tab10\")[5]\n",
                "grey = \"grey\"\n",
                "\n",
                "# ------ source  (unimodal)  and  target (bimodal) ----------------\n",
                "mu_s, sigma_s = 0.0, 1.0  # q0  ~  N(0,1)\n",
                "\n",
                "w = np.array([0.5, 0.5])  # mixture weights\n",
                "mu_t = np.array([-2.5, 2.5])  # component means\n",
                "sigma_t = np.array([0.5, 0.5])  # component stds\n",
                "\n",
                "\n",
                "# ------ log densities and gradients -----------------------------\n",
                "def log_q0(x):\n",
                "    return -0.5 * ((x - mu_s) ** 2) / (sigma_s**2) - np.log(\n",
                "        np.sqrt(2 * np.pi) * sigma_s\n",
                "    )\n",
                "\n",
                "\n",
                "def grad_log_q0(x):\n",
                "    return -(x - mu_s) / (sigma_s**2)\n",
                "\n",
                "\n",
                "def _mix_pdf(x):\n",
                "    return w[0] * norm.pdf(x, mu_t[0], sigma_t[0]) + w[1] * norm.pdf(\n",
                "        x, mu_t[1], sigma_t[1]\n",
                "    )\n",
                "\n",
                "\n",
                "def log_p(x):\n",
                "    return np.log(_mix_pdf(x))\n",
                "\n",
                "\n",
                "def grad_log_p(x):\n",
                "    comp = np.vstack([w[i] * norm.pdf(x, mu_t[i], sigma_t[i]) for i in range(2)])\n",
                "    denom = comp.sum(axis=0)  # p(x)\n",
                "    num = -((x - mu_t[:, None]) / (sigma_t[:, None] ** 2)) * comp\n",
                "    return num.sum(axis=0) / denom\n",
                "\n",
                "\n",
                "def grad_log_gamma(x, t):\n",
                "    \"\"\"∇ log γ_t(x) for linear annealing γ_t ∝ q0^{1-t} · p^{t}.\"\"\"\n",
                "    return (1 - t) * grad_log_q0(x) + t * grad_log_p(x)\n",
                "\n",
                "\n",
                "# ------ ULA simulation parameters --------------------------------\n",
                "n_particles = 10\n",
                "n_steps = 2_00\n",
                "eps = 1e-3  # Langevin step size\n",
                "t_grid = np.linspace(0, 1, n_steps)\n",
                "\n",
                "paths = np.empty((n_particles, n_steps))\n",
                "paths[:, 0] = np.random.normal(mu_s, sigma_s, size=n_particles)\n",
                "\n",
                "strip_width = 0.08\n",
                "\n",
                "# main loop\n",
                "for k in range(n_steps - 1):\n",
                "    t_k = t_grid[k]\n",
                "    grad = grad_log_gamma(paths[:, k], t_k)\n",
                "    noise = np.random.normal(0.0, np.sqrt(2 * eps), size=n_particles)\n",
                "    paths[:, k + 1] = paths[:, k] + eps * grad + noise\n",
                "\n",
                "# ------ reverse simulation (target → source) --------------------\n",
                "paths_rev = np.empty((n_particles, n_steps))\n",
                "paths_rev[:, 0] = sample_target(n_particles)  # start in p(x)\n",
                "\n",
                "for k in range(n_steps - 1):\n",
                "    t_k = 1.0 - t_grid[k]  #   1 → 0\n",
                "    grad = grad_log_gamma(paths_rev[:, k], t_k)\n",
                "    noise = np.random.normal(0.0, np.sqrt(2 * eps), size=n_particles)\n",
                "    paths_rev[:, k + 1] = paths_rev[:, k] + eps * grad + noise\n",
                "\n",
                "# ------ figure & axes -------------------------------------------\n",
                "fig, ax = plt.subplots(figsize=(8.27, 4.13), dpi=300)\n",
                "\n",
                "# ------ plot trajectories ---------------------------------------\n",
                "for j in range(n_particles):\n",
                "    ax.plot(\n",
                "        t_grid[::1],\n",
                "        paths[j, ::1],\n",
                "        color=sns_blue,\n",
                "        ls=\"--\",\n",
                "        alpha=0.3,\n",
                "        label=r\"ULA trajectory\" if j == 0 else None,\n",
                "    )\n",
                "\n",
                "\n",
                "# ------ helper: density strip facing right -----------------------\n",
                "def paint_density_strip(ax, t_pos, colour, strip_width=0.08):\n",
                "    \"\"\"\n",
                "    Draw a right-facing density strip at horizontal position t_pos.\n",
                "    The strip's width encodes the pdf height.\n",
                "    \"\"\"\n",
                "    y = np.linspace(-8, 8, 400)\n",
                "\n",
                "    if np.isclose(t_pos, 0.0):\n",
                "        pdf = np.exp(log_q0(y))\n",
                "    elif np.isclose(t_pos, 1.0):\n",
                "        pdf = np.exp(log_p(y))\n",
                "    else:\n",
                "        pdf = np.exp((1 - t_pos) * log_q0(y) + t_pos * log_p(y))\n",
                "\n",
                "    pdf = pdf / pdf.max() * strip_width  # rescale\n",
                "\n",
                "    # rectangle: left edge at t_pos, right edge at t_pos + pdf\n",
                "    ax.fill_betweenx(y, t_pos, t_pos + pdf, color=colour, alpha=0.18, lw=0)\n",
                "    ax.plot(t_pos + pdf, y, color=colour, lw=1)  # right border\n",
                "\n",
                "\n",
                "# draw strips at t = {0, 1/3, 2/3, 1}\n",
                "snap_ts = [0.0, 0.33, 0.66, 1.0]\n",
                "# Create a colormap that interpolates between grey and sns_brown\n",
                "from matplotlib.colors import LinearSegmentedColormap\n",
                "\n",
                "cmap = LinearSegmentedColormap.from_list(\"grey_to_brown\", [grey, sns_brown])\n",
                "# Sample colors at the specified positions\n",
                "strip_col = [cmap(t) for t in [0.0, 0.33, 0.66, 1.0]]\n",
                "\n",
                "for t_snap, c in zip(snap_ts, strip_col):\n",
                "    paint_density_strip(ax, t_snap, c, strip_width=strip_width)\n",
                "\n",
                "# ------ axis cosmetics -------------------------------------------\n",
                "ax.set_xlim(\n",
                "    [0, 1 + strip_width * 1.10]\n",
                ")  # <-- add ~10 % head-room past the strip                    # tiny bit of padding on right\n",
                "ax.set_ylim([-8, 8])\n",
                "# ax.set_title(r\"Annealed Unadjusted Langevin Sampler\", pad=10, fontsize=16)\n",
                "\n",
                "ax.set_xticks(\n",
                "    [0, 0.33, 0.66, 1],\n",
                "    [r\"$0$\", r\"$\\frac{1}{3}$\", r\"$\\frac{2}{3}$\", r\"$1$\"],\n",
                "    fontsize=12,\n",
                ")\n",
                "ax.set_yticks([-8, 0, 8], [-8, 0, 8], fontsize=12)\n",
                "\n",
                "ax.set_xlabel(r\"$t$\", fontsize=14, labelpad=6)\n",
                "ax.set_ylabel(r\"$X_t$\", fontsize=14, labelpad=6)\n",
                "\n",
                "for spine in [\"top\", \"right\", \"bottom\", \"left\"]:\n",
                "    ax.spines[spine].set_visible(False)\n",
                "\n",
                "ax.legend(frameon=False, fontsize=10)\n",
                "plt.tight_layout()\n",
                "\n",
                "# ------ save / show ----------------------------------------------\n",
                "# out_dir = Path(\"./figs\")\n",
                "# out_dir.mkdir(parents=True, exist_ok=True)\n",
                "\n",
                "# fig.savefig(out_dir / \"annealed_ula_demo_facing_right.pdf\", bbox_inches=\"tight\")\n",
                "# fig.savefig(out_dir / \"annealed_ula_demo_facing_right.png\",\n",
                "#             dpi=300, transparent=True, bbox_inches=\"tight\")\n",
                "plt.show()"
            ]
        },
