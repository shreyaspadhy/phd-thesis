            "source": [
                "# ---------------------------------------------------------------\n",
                "#  1-D Annealed samplers:  ULA fwd (blue),  ULA rev (orange),\n",
                "#                          CMCD fwd with learned score (red)\n",
                "# ---------------------------------------------------------------\n",
                "import math\n",
                "import time\n",
                "import warnings\n",
                "\n",
                "import matplotlib\n",
                "import matplotlib.pyplot as plt\n",
                "import numpy as np\n",
                "import seaborn as sns\n",
                "import torch\n",
                "import torch.nn as nn\n",
                "from torch.distributions.normal import Normal\n",
                "\n",
                "warnings.filterwarnings(\"ignore\", category=UserWarning)\n",
                "device = \"cpu\"  # runs in < 5-10 seconds on a laptop\n",
                "\n",
                "# --------- matplotlib cosmetics (unchanged) ---------------------\n",
                "matplotlib.rcParams[\"axes.unicode_minus\"] = False\n",
                "plt.rcParams.update({\"text.usetex\": True, \"font.family\": \"serif\"})\n",
                "plt.rc(\"text.latex\", preamble=r\"\\usepackage{amsfonts}\\usepackage{amsmath}\")\n",
                "\n",
                "sns_blue, sns_orange, sns_red = sns.color_palette(\"tab10\")[:3]\n",
                "sns_brown, grey = sns.color_palette(\"tab10\")[5], \"grey\"\n",
                "\n",
                "# =========  1-D source  & target  (and their scores) ============\n",
                "mu_s, sigma_s = 0.0, 1.0  # source  q0  = N(0,1)\n",
                "w = torch.tensor([0.5, 0.5], device=device)\n",
                "mu_t = torch.tensor([-3.5, 3.5], device=device)\n",
                "sigma_t = torch.tensor([0.5, 0.5], device=device)\n",
                "\n",
                "\n",
                "def log_q0(x):\n",
                "    return Normal(0.0, 1.0).log_prob(x)\n",
                "\n",
                "\n",
                "def grad_log_q0(x):\n",
                "    return -x  # ∇ log N(0,1)\n",
                "\n",
                "\n",
                "def _gauss(x, m, s):  # pdf\n",
                "    return torch.exp(-0.5 * ((x - m) / s) ** 2) / (s * math.sqrt(2 * math.pi))\n",
                "\n",
                "\n",
                "def log_p(x):\n",
                "    pdf = w[0] * _gauss(x, mu_t[0], sigma_t[0]) + w[1] * _gauss(x, mu_t[1], sigma_t[1])\n",
                "    return torch.log(pdf)\n",
                "\n",
                "\n",
                "def grad_log_p(x):\n",
                "    pdf0 = w[0] * _gauss(x, mu_t[0], sigma_t[0])\n",
                "    pdf1 = w[1] * _gauss(x, mu_t[1], sigma_t[1])\n",
                "    denom = pdf0 + pdf1\n",
                "    num = (\n",
                "        -(x - mu_t[0]) / (sigma_t[0] ** 2) * pdf0\n",
                "        - (x - mu_t[1]) / (sigma_t[1] ** 2) * pdf1\n",
                "    )\n",
                "    return num / denom\n",
                "\n",
                "\n",
                "def grad_log_gamma(x, t):  # analytic score\n",
                "    return (1 - t) * grad_log_q0(x) + t * grad_log_p(x)\n",
                "\n",
                "\n",
                "# helper: log Normal pdf for a given σ  (vectorised)\n",
                "def log_normal(x, mean, std):\n",
                "    return -0.5 * ((x - mean) / std) ** 2 - torch.log(std * math.sqrt(2 * math.pi))\n",
                "\n",
                "\n",
                "# =========  sampler hyper-params  ===============================\n",
                "n_part_plot = 50  # particles to display\n",
                "n_steps_plot = 100  # resolution for the plotted paths\n",
                "\n",
                "n_bridges = 100  # CMCD training discretisation\n",
                "dt = 1.0 / n_bridges\n",
                "eps = dt  # ε  (matches repo:  ε = σ²·dt)\n",
                "\n",
                "batch_size = 256  # training batch\n",
                "n_train_iter = 2_00  # keep it tiny → visible difference already\n",
                "lr = 1e-2\n",
                "\n",
                "\n",
                "# =========  score network – 2-layer MLP  ========================\n",
                "class ScoreMLP(nn.Module):\n",
                "    def __init__(self):\n",
                "        super().__init__()\n",
                "        self.net = nn.Sequential(nn.Linear(2, 32), nn.Tanh(), nn.Linear(32, 1))\n",
                "\n",
                "    def forward(self, x, t):\n",
                "        # x: (B,1) ; t: (B,1)  in [0,1]\n",
                "        inp = torch.cat([x, t], dim=1)\n",
                "        return self.net(inp)\n",
                "\n",
                "\n",
                "score_net = ScoreMLP().to(device)\n",
                "\n",
                "\n",
                "# =========  Generate and save noise for reproducible trajectories  =========\n",
                "def generate_fixed_noise(n_samples, n_steps, shape=(1,)):\n",
                "    \"\"\"\n",
                "    Generate fixed noise for reproducible trajectories.\n",
                "\n",
                "    Args:\n",
                "        n_samples: Number of particles/samples\n",
                "        n_steps: Number of time steps\n",
                "        shape: Shape of each noise sample (excluding batch dimension)\n",
                "\n",
                "    Returns:\n",
                "        List of noise arrays, one for each time step\n",
                "    \"\"\"\n",
                "    np.random.seed(42)  # For reproducibility\n",
                "    fixed_noise = []\n",
                "    for _ in range(n_steps):\n",
                "        noise = np.random.normal(0, 1, size=(n_samples, *shape))\n",
                "        fixed_noise.append(noise)\n",
                "    return fixed_noise\n",
                "\n",
                "\n",
                "# Generate fixed noise for plotting and training\n",
                "plot_noise = generate_fixed_noise(n_part_plot, n_steps_plot)\n",
                "train_noise = generate_fixed_noise(batch_size, n_bridges)\n",
                "\n",
                "\n",
                "# =========  CMCD  –  one forward pass that also returns ln_rnd ==\n",
                "def cmcd_sample(score_net, B, return_traj=False, plot_noise=None):\n",
                "    x = torch.randn(B, 1, device=device)  # start from q0\n",
                "    ln_w = -log_q0(x).squeeze(-1)  # -log q0(x₀)\n",
                "    traj = [x.detach().cpu().numpy()] if return_traj else None\n",
                "    std = torch.tensor(math.sqrt(2 * dt), device=device)\n",
                "\n",
                "    for i in range(n_bridges):\n",
                "        t = torch.full_like(x, i / n_bridges)\n",
                "        t_next = torch.full_like(x, (i + 1) / n_bridges)\n",
                "\n",
                "        grad = grad_log_gamma(x, t)\n",
                "        drift = grad + score_net(x, t)\n",
                "\n",
                "        mean_f = x + dt * drift\n",
                "        noise = torch.randn_like(x) if plot_noise is None else plot_noise[i]\n",
                "        x_new = mean_f + std * noise\n",
                "\n",
                "        grad_n = grad_log_gamma(x_new, t_next)\n",
                "        drift_r = grad_n - score_net(x_new, t_next)  # reverse drift\n",
                "\n",
                "        mean_b = x_new + dt * drift_r\n",
                "\n",
                "        ln_fwd = log_normal(x_new, mean_f, std).squeeze(-1)\n",
                "        ln_bwd = log_normal(x, mean_b, std).squeeze(-1)\n",
                "\n",
                "        ln_w += ln_bwd - ln_fwd  # importance ratio\n",
                "        x = x_new\n",
                "        if return_traj:\n",
                "            traj.append(x.detach().cpu().numpy())\n",
                "\n",
                "    ln_w += log_p(x).squeeze(-1)  # +log p(x_T)\n",
                "    if return_traj:\n",
                "        return ln_w, np.stack(traj)  # [T+1,B,1]\n",
                "    return ln_w\n",
                "\n",
                "\n",
                "# =========  TRAIN the score network via reverse-KL ==============\n",
                "from tqdm import tqdm\n",
                "\n",
                "opt = torch.optim.Adam(score_net.parameters(), lr=lr)\n",
                "start = time.time()\n",
                "for it in tqdm(range(1, n_train_iter + 1)):\n",
                "    ln_w = cmcd_sample(score_net, batch_size)  # [B]\n",
                "    loss = (-ln_w).mean()  # Reverse-KL\n",
                "    opt.zero_grad()\n",
                "    loss.backward()\n",
                "    opt.step()\n",
                "    if it % 500 == 0:\n",
                "        print(f\"iter {it:4d}/{n_train_iter}  loss={loss.item():.3f}\")\n",
                "print(f\"training finished in {time.time() - start:.1f}s\")"
            ]
        },
        {
