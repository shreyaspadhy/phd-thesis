                "# ---------------------------------------------------------------\n",
                "#  Annealed ULA demo – forward (blue) and reverse (red) paths\n",
                "# ---------------------------------------------------------------\n",
                "import matplotlib\n",
                "import matplotlib.pyplot as plt\n",
                "import numpy as np\n",
                "import seaborn as sns\n",
                "\n",
                "# ------ matplotlib / LaTeX cosmetics (optional) -----------------\n",
                "matplotlib.rcParams[\"axes.unicode_minus\"] = False\n",
                "plt.rcParams.update({\"text.usetex\": True, \"font.family\": \"serif\"})\n",
                "plt.rc(\"text.latex\", preamble=r\"\\usepackage{amsfonts}\\usepackage{amsmath}\")\n",
                "\n",
                "sns_blue = sns.color_palette(\"tab10\")[0]  # forward trajectories\n",
                "sns_red = sns.color_palette(\"tab10\")[3]  # reverse trajectories\n",
                "sns_brown = sns.color_palette(\"tab10\")[5]\n",
                "grey = \"grey\"\n",
                "\n",
                "# ------ source  (unimodal)  and  target (bimodal) ----------------\n",
                "mu_s, sigma_s = 0.0, 1.0  # q0  ~  N(0,1)\n",
                "\n",
                "w = np.array([0.5, 0.5])  # mixture weights\n",
                "mu_t = np.array([-3.5, 3.5])  # component means\n",
                "sigma_t = np.array([0.5, 0.5])  # component stds\n",
                "\n",
                "\n",
                "def sample_target(n):\n",
                "    \"\"\"Draw n samples from the bimodal target mixture.\"\"\"\n",
                "    choices = np.random.choice([0, 1], size=n, p=w)\n",
                "    return np.random.normal(mu_t[choices], sigma_t[choices])\n",
                "\n",
                "\n",
                "# ------ log densities and gradients -----------------------------\n",
                "def log_q0(x):\n",
                "    return -0.5 * ((x - mu_s) ** 2) / (sigma_s**2) - np.log(\n",
                "        np.sqrt(2 * np.pi) * sigma_s\n",
                "    )\n",
                "\n",
                "\n",
                "def grad_log_q0(x):\n",
                "    return -(x - mu_s) / (sigma_s**2)\n",
                "\n",
                "\n",
                "def _mix_pdf(x):\n",
                "    return w[0] * norm.pdf(x, mu_t[0], sigma_t[0]) + w[1] * norm.pdf(\n",
                "        x, mu_t[1], sigma_t[1]\n",
                "    )\n",
                "\n",
                "\n",
                "def log_p(x):\n",
                "    return np.log(_mix_pdf(x))\n",
                "\n",
                "\n",
                "def grad_log_p(x):\n",
                "    comp = np.vstack([w[i] * norm.pdf(x, mu_t[i], sigma_t[i]) for i in range(2)])\n",
                "    denom = comp.sum(axis=0)  # p(x)\n",
                "    num = -((x - mu_t[:, None]) / (sigma_t[:, None] ** 2)) * comp\n",
                "    return num.sum(axis=0) / denom\n",
                "\n",
                "\n",
                "def grad_log_gamma(x, t):\n",
                "    \"\"\"∇ log γ_t(x) for linear annealing γ_t ∝ q0^{1-t} · p^{t}.\"\"\"\n",
                "    return (1 - t) * grad_log_q0(x) + t * grad_log_p(x)\n",
                "\n",
                "\n",
                "# ------ ULA parameters ------------------------------------------\n",
                "n_particles = 50\n",
                "n_steps = 500\n",
                "eps = 1e-3\n",
                "t_grid = np.linspace(0, 1, n_steps)\n",
                "\n",
                "# ------ forward simulation (source → target) --------------------\n",
                "paths_fwd = np.empty((n_particles, n_steps))\n",
                "paths_fwd[:, 0] = np.random.normal(mu_s, sigma_s, size=n_particles)\n",
                "\n",
                "for k in range(n_steps - 1):\n",
                "    t_k = t_grid[k]  #   0 → 1\n",
                "    grad = grad_log_gamma(paths_fwd[:, k], t_k)\n",
                "    noise = np.random.normal(0.0, np.sqrt(2 * eps), size=n_particles)\n",
                "    paths_fwd[:, k + 1] = paths_fwd[:, k] + eps * grad + noise\n",
                "\n",
                "# ------ reverse simulation (target → source) --------------------\n",
                "paths_rev = np.empty((n_particles, n_steps))\n",
                "paths_rev[:, 0] = sample_target(n_particles)  # start in p(x)\n",
                "\n",
                "for k in range(n_steps - 1):\n",
                "    t_k = 1.0 - t_grid[k]  #   1 → 0\n",
                "    grad = grad_log_gamma(paths_rev[:, k], t_k)\n",
                "    noise = np.random.normal(0.0, np.sqrt(2 * eps), size=n_particles)\n",
                "    paths_rev[:, k + 1] = paths_rev[:, k] + eps * grad + noise\n",
                "\n",
                "# ------ figure & axes -------------------------------------------\n",
                "fig, ax = plt.subplots(figsize=(8.0, 4.0), dpi=300)\n",
                "\n",
                "# --- plot forward (blue) and reverse (red) trajectories ----------\n",
                "thin = slice(None, None, 1)  # visual thinning ratio\n",
                "\n",
                "# for j in range(n_particles):\n",
                "#     ax.plot(t_grid[thin], paths_fwd[j, thin],\n",
                "#             color=sns_blue, ls=\"--\",\n",
                "#             alpha=0.5,\n",
                "#             label=r\"ULA forward\" if j == 0 else None)\n",
                "\n",
                "# for j in range(n_particles):\n",
                "#     ax.plot(1 - t_grid[thin], paths_rev[j, thin],\n",
                "#             color=sns_red, ls=\"--\" if j else \"-\",\n",
                "#             alpha=0.5 if j else 0.8,\n",
                "#             label=r\"ULA reverse\" if j == 0 else None)\n",
                "\n",
                "# ------ density strips (still facing right) ----------------------\n",
                "strip_width = 0.08\n",
                "\n",
                "\n",
                "def paint_density_strip(ax, t_pos, colour, strip_width=0.08):\n",
                "    y = np.linspace(-8, 8, 400)\n",
                "    if np.isclose(t_pos, 0.0):\n",
                "        pdf = np.exp(log_q0(y))\n",
                "    elif np.isclose(t_pos, 1.0):\n",
                "        pdf = np.exp(log_p(y))\n",
                "    else:\n",
                "        pdf = np.exp((1 - t_pos) * log_q0(y) + t_pos * log_p(y))\n",
                "    pdf = pdf / pdf.max() * strip_width\n",
                "    ax.fill_betweenx(y, t_pos, t_pos + pdf, color=colour, alpha=0.18, lw=0)\n",
                "    ax.plot(t_pos + pdf, y, color=colour, lw=1)\n",
                "\n",
