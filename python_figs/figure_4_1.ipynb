            "source": [
                "# =========  ULA (fwd / rev)  &  CMCD (fwd) trajectories =========\n",
                "t_grid = np.linspace(0, 1, n_steps_plot, dtype=np.float32)\n",
                "std_f = math.sqrt(2 * eps)\n",
                "\n",
                "\n",
                "def simulate_paths(drift_fn, x0, plot_noise=None, n_steps=n_steps_plot):\n",
                "    paths = np.empty((n_part_plot, n_steps), dtype=np.float32)\n",
                "    paths[:, 0] = x0\n",
                "    for k in range(n_steps - 1):\n",
                "        t = t_grid[k]\n",
                "        drift = drift_fn(paths[:, k], t)\n",
                "        noise = (\n",
                "            np.random.normal(0, std_f, size=n_part_plot)\n",
                "            if plot_noise is None\n",
                "            else plot_noise[k].squeeze() * std_f\n",
                "        )\n",
                "        # print(paths[:, k].shape, eps, drift.shape, noise.shape)\n",
                "        paths[:, k + 1] = paths[:, k] + eps * drift + noise\n",
                "    return paths\n",
                "\n",
                "\n",
                "# analytic drifts\n",
                "drift_fwd = lambda x, t: grad_log_gamma(torch.tensor(x), t).numpy()\n",
                "drift_rev = lambda x, t: grad_log_gamma(torch.tensor(x), 1.0 - t).numpy()\n",
                "\n",
                "\n",
                "# learned CMCD drift\n",
                "def drift_cmcd(x, t):\n",
                "    x_t = torch.tensor(x, dtype=torch.float32, device=device).view(-1, 1)\n",
                "    t_t = torch.full_like(x_t, t)\n",
                "    with torch.no_grad():\n",
                "        s = score_net(x_t, t_t).cpu().numpy().squeeze()\n",
                "    return grad_log_gamma(torch.tensor(x), t).numpy() + s\n",
                "\n",
                "\n",
                "# learned CMCD drift\n",
                "def drift_cmcd_back(x, t):\n",
                "    x_t = torch.tensor(x, dtype=torch.float32, device=device).view(-1, 1)\n",
                "    t_t = torch.full_like(x_t, t)\n",
                "    with torch.no_grad():\n",
                "        s = score_net(x_t, t_t).cpu().numpy().squeeze()\n",
                "    return grad_log_gamma(torch.tensor(x), t).numpy() - s\n",
                "\n",
                "\n",
                "# initial particles\n",
                "x0_src = np.random.normal(0, 1, n_part_plot).astype(np.float32)\n",
                "x0_tar = np.concatenate(\n",
                "    [\n",
                "        np.random.normal(-2.5, 0.5, n_part_plot // 2),\n",
                "        np.random.normal(2.5, 0.5, n_part_plot - n_part_plot // 2),\n",
                "    ]\n",
                ").astype(np.float32)\n",
                "\n",
                "paths_fwd = simulate_paths(\n",
                "    drift_fwd, x0_src, plot_noise=plot_noise, n_steps=n_steps_plot // 2\n",
                ")\n",
                "paths_rev = simulate_paths(\n",
                "    drift_rev, x0_tar, plot_noise=plot_noise, n_steps=n_steps_plot // 2\n",
                ")\n",
                "paths_cmd = simulate_paths(drift_cmcd, x0_src, plot_noise=plot_noise)\n",
                "# paths_cmd_back = simulate_paths(drift_cmcd_back, x0_tar, plot_noise=plot_noise)"
            ]
